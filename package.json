{
  "name": "@misofm/privy-auth",
  "version": "0.2.0",
  "private": true,
  "description": "Privy sign-in shared by Miso's apps, in Effect: the embedded Sui wallet, Privy's failures, its config, identity tokens verified on the server, and the sign-in screen's hooks and parts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/privy-auth.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signer": {
      "types": "./dist/signer.d.ts",
      "import": "./dist/signer.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --coverage",
    "pack": "bun run build && mkdir -p dist-pack && bun pm pack --filename dist-pack/misofm-privy-auth.tgz"
  },
  "peerDependencies": {
    "@mysten/sui": "2.38.0",
    "@privy-io/react-auth": "3.52.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "effect": ">=4.1.2 <4.2",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@mysten/sui": {
      "optional": true
    },
    "@privy-io/react-auth": {
      "optional": true
    },
    "@ui-sdk/core": {
      "optional": true
    },
    "@ui-sdk/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@mysten/sui": "2.38.0",
    "@privy-io/react-auth": "3.52.0",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "effect": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
